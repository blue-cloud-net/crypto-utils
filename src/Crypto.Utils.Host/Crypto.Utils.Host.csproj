<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Crypto.Utils</RootNamespace>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <SpaRoot>..\Crypto.Utils.UI\</SpaRoot>
        <SpaDistRoot>wwwroot\</SpaDistRoot>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="7.0.20"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Crypto.Utils.Api\Crypto.Utils.Api.csproj"/>
    </ItemGroup>

    <!-- 检查 Node.js 环境 -->
    <Target Name="CheckNodeEnv" BeforeTargets="BuildUI">
        <Message Importance="high" Text="Checking Node.js environment..."/>
        <Exec Command="node --version" ContinueOnError="true">
            <Output TaskParameter="ExitCode" PropertyName="NodeErrorCode"/>
        </Exec>
        <Error Condition="'$(NodeErrorCode)' != '0'" Text="Node.js is required to build this project. Please install Node.js from https://nodejs.org/"/>

        <Exec Command="pnpm --version" ContinueOnError="true" WorkingDirectory="$(SpaRoot)">
            <Output TaskParameter="ExitCode" PropertyName="PnpmErrorCode"/>
        </Exec>
        <Error Condition="'$(PnpmErrorCode)' != '0'" Text="pnpm is required to build this project. Please install pnpm using 'npm install -g pnpm'"/>
    </Target>

    <!-- 安装 UI 项目依赖 -->
    <Target Name="InstallUIDependencies" BeforeTargets="BuildUI" DependsOnTargets="CheckNodeEnv" Condition="!Exists('$(SpaRoot)node_modules')">
        <Message Importance="high" Text="Installing UI dependencies using pnpm..."/>
        <Exec WorkingDirectory="$(SpaRoot)" Command="pnpm install"/>
    </Target>

    <!-- 构建 UI 项目 -->
    <Target Name="BuildUI" BeforeTargets="Build" DependsOnTargets="CheckNodeEnv;InstallUIDependencies">
        <Message Importance="high" Text="Building UI project..."/>
        <Exec WorkingDirectory="$(SpaRoot)" Command="pnpm run build"/>
    </Target>

    <!-- 复制 UI 构建产物到 wwwroot -->
    <Target Name="CopyUIToWwwroot" AfterTargets="BuildUI" BeforeTargets="Build">
        <Message Importance="high" Text="Copying UI build output to wwwroot..."/>

        <!-- 清空目标目录 -->
        <RemoveDir Directories="$(SpaDistRoot)" Condition="Exists('$(SpaDistRoot)')"/>
        <MakeDir Directories="$(SpaDistRoot)"/>

        <!-- 复制 dist 目录内容到 wwwroot -->
        <ItemGroup>
            <UIDistFiles Include="$(SpaRoot)dist\**\*.*"/>
        </ItemGroup>
        <Copy SourceFiles="@(UIDistFiles)" DestinationFolder="$(SpaDistRoot)%(RecursiveDir)"/>

        <Message Importance="high" Text="UI files copied to $(SpaDistRoot)"/>
    </Target>

    <!-- 确保 wwwroot 中的文件被包含到发布输出中 -->
    <!-- <ItemGroup>
      <Content Include="wwwroot\**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup> -->

</Project>
