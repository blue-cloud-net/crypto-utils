<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2"/>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Resources\EnumResources.resx">
        <Generator>ResXFileCodeGenerator</Generator>
        <LastGenOutput>EnumResources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
      <EmbeddedResource Update="Resources\EnumResources.en-us.resx">
        <DependentUpon>EnumResources.resx</DependentUpon>
      </EmbeddedResource>
      <EmbeddedResource Update="Resources\EnumResources.zh-hans.resx">
        <DependentUpon>EnumResources.resx</DependentUpon>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Resources\EnumResources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>EnumResources.resx</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
